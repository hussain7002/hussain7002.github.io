---
import { publications } from '../data/site';
interface Props { large?: boolean; compact?: boolean }
const { large = false, compact = false } = Astro.props;
---
<div class:list={['pub-grid', { 'pub-grid-lg': large }]}>
  {publications.map((p) => (
    <a class="pub-card rv" href={p.href} target="_blank" rel="noopener">
      <div class={`pthumb t-${p.tint}`}>
        <img src={p.cover} alt={`Cover of ${p.title}`} width="720" height="1018" loading="lazy" decoding="async">
      </div>
      <span class="org" style={`--c:var(--${p.tint})`}>{p.org}</span>
      <h3>{p.title}</h3>
      {!compact && <p>{p.src}</p>}
      <span class="more">View publication ↗</span>
    </a>
  ))}
</div>
