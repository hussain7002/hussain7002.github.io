---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" contact={false}>
<header class="page-head">
  <div class="wrap">
    <div class="eyebrow" style="--dot:var(--red)">404</div>
    <h1>This page isn't on the map.</h1>
    <div class="actions"><a class="btn primary" href="/">Go to the homepage →</a><a class="btn ghost" href="/work/">See the work</a></div>
  </div>
</header>
</Base>
