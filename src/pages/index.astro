---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { getCollection } from 'astro:content';
import { getArticles } from '../lib/writing';
const tints: Record<string, string> = { DPI: 'blue', 'Health data': 'green', 'Health systems': 'yellow', AI: 'red' };
import { lab, publications } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const homeWork = work.filter((w) => w.data.home).slice(0, 2);
const homeLab = lab.slice(0, 3);
const articles = await getArticles();
const published = articles.filter((a) => !a.data.draft);
const featured = published.find((a) => a.data.featured) ?? published[0];
const upcoming = articles.filter((a) => a.data.draft).slice(0, 3);
---
<Base>
<header class="hero" id="top">
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="wrap">
    <div>
      <div class="eyebrow">Digital public infrastructure · Data &amp; AI · Public health</div>
      <h1>Public health runs on <span class="hl">data.</span> <span class="c-blue">I build the systems that carry it.</span></h1>
      <p class="lede">IIT Kharagpur engineer. Data strategist to India's <strong>National Urban Health Mission</strong> for the Asian Development Bank, and Senior Consultant at Deloitte; before that, nearly four years at PATH. I turn government data, digital public infrastructure and AI into services that reach people.</p>
      <div class="actions">
        <a class="btn primary" href="/work/">See selected work <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href="/about/">About me</a>
      </div>
    </div>
  </div>
</header>

<section class="figures" aria-label="Impact in numbers">
  <div class="wrap">
    <div class="eyebrow">At a glance</div>
    <div class="fig-grid">
      <div class="fig rv"><div class="n">500M+</div><p>Urban residents covered by the mission I advise</p></div>
      <div class="fig rv"><div class="n">35</div><p>States and UTs whose health-portal data I analyse</p></div>
      <div class="fig rv"><div class="n">2→15%</div><p>Pregnancies identified as high-risk, after a screening redesign</p></div>
      <div class="fig rv"><div class="n">~300</div><p>Health facilities on a platform I led end to end</p></div>
    </div>
  </div>
</section>

<section class="about-teaser" id="about">
  <div class="wrap">
    <div>
      <div class="eyebrow">About</div>
      <h2>Engineer by training. Public health by choice.</h2>
      <p>I studied biotechnology and biochemical engineering at IIT Kharagpur, then spent nearly five years inside India's public health system: in maternal health programmes, hospital oxygen, state health departments and now a national mission. Off work, it's football, taekwondo and theatre.</p>
      <a class="see-all" style="--c:var(--yellow);margin-top:24px" href="/about/">More about me →</a>
    </div>
    <ul class="creds">
      <li><div><b>IIT Kharagpur</b><span class="sub">B.Tech + M.Tech dual degree, Biotechnology &amp; Biochemical Engineering</span></div><span>2016–21</span></li>
      <li><div><b>GATE 2020</b><span class="sub">All India Rank 209</span></div><span>AIR 209</span></li>
      <li><div><b>JEE Main 2016</b><span class="sub">All India Rank 256</span></div><span>AIR 256</span></li>
    </ul>
  </div>
</section>

<section class="practice-intro" id="practice">
  <div class="wrap">
    <div><div class="eyebrow">Practice</div><h2>Four kinds of work. One test: does it reach the person?</h2></div>
    <p>Health is the proving ground; the methods travel. Each engagement moves between the frontline and the national plan, and from a specification to a working prototype.</p>
  </div>
</section>

<div class="bands">
  <section class="band b1"><div class="wrap">
    <div class="idx">STRATEGY</div>
    <div class="body"><h3>Data strategy for national programmes</h3><p>Turning fragmented portal data into decisions for mission leadership: facilities, workforce, drugs, diagnostics, teleconsultation and spend, read together.</p></div>
    <div class="proof"><div class="k">$300M</div><div class="cap">ADB results-based loan for urban primary health care</div><ul><li>National Urban Health Mission, MoHFW</li><li>State digital transformation roadmap</li></ul></div>
  </div></section>
  <section class="band b2"><div class="wrap">
    <div class="idx">PRODUCT</div>
    <div class="body"><h3>Digital products and public infrastructure</h3><p>Specifications, user journeys, UAT and security audits for government platforms, and QR-based registration on digital health IDs for paperless hospitals.</p></div>
    <div class="proof"><div class="k">~300</div><div class="cap">Facilities on the Chhattisgarh assessment and citizen-feedback platform</div><ul><li>Maternal health dashboard, two portals in one view</li><li>NUHM dashboard prototype</li></ul></div>
  </div></section>
  <section class="band b3"><div class="wrap">
    <div class="idx">GEOSPATIAL</div>
    <div class="body"><h3>Mapping who is left out</h3><p>GIS tools that map urban vulnerability down to wards, slums and households, so medical officers can plan facilities, camps and outreach where need is greatest.</p></div>
    <div class="proof"><div class="k">Ward-level</div><div class="cap">Planning resolution for state teams in Tripura</div><ul><li>Slum and household layers</li><li>Trained state teams and medical officers</li></ul></div>
  </div></section>
  <section class="band b4"><div class="wrap">
    <div class="idx">AI</div>
    <div class="body"><h3>AI in frontline public services</h3><p>Conversational tools for the people who keep the system running, and a critical eye on which AI and health technologies are ready for public use.</p></div>
    <div class="proof"><div class="k">40+</div><div class="cap">Medtech and digital health innovations evaluated for public health adoption</div><ul><li>OxyChat: multilingual WhatsApp chatbot, 500+ users</li><li>OPD queue assistant: product design</li><li>AI-assisted NUHM dashboard prototype</li></ul></div>
  </div></section>
</div>
<div class="band-end" aria-hidden="true"></div>

<section class="sec work" id="work">
  <div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">Selected work</div><h2>Case studies</h2></div><a class="see-all" href="/work/">All {work.length} case studies →</a></div>
    <div class="work-grid">
      {homeWork.map((w) => <CaseCard entry={w} />)}
    </div>
  </div>
</section>

{homeLab.length > 0 && (
<section class="sec lab" id="lab">
  <div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">Lab</div><h2>Tools and prototypes</h2></div><div class="side"><p>Working things I've built, from an AI-assisted national dashboard prototype to tools delivered to state governments.</p><a class="see-all" style="--c:var(--green)" href="/lab/">Explore the Lab →</a></div></div>
    <div class="lab-grid">
      {homeLab.map((t) => (
        <article class={`tool t-${t.tint}`} style={`--c:var(--${t.tint});--r:${t.shape}`}>
          <div class="ico"><span></span></div><span class="pill">{t.status}</span><h3>{t.title}</h3><p>{t.text}</p><a class="more" href={t.href}>View →</a>
        </article>
      ))}
    </div>
  </div>
</section>
)}

{articles.length > 0 && (
<section class="sec writing" id="writing">
  <div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">Writing</div><h2>Essays and articles</h2></div><div class="side"><p>On digital public infrastructure, health data, AI and how public systems actually change.</p><a class="see-all" style="--c:var(--red)" href="/writing/">All {articles.length} articles →</a></div></div>
    {featured ? (
      <a class="feature rv" href={`/writing/${featured.id}/`}>
        <div class="art"><canvas data-art="feature" aria-hidden="true"></canvas></div>
        <div><div class="kicker">Featured · {featured.data.minutes} min</div><h3>{featured.data.title}</h3><p>{featured.data.summary}</p><span class="more" style="display:inline-block;margin-top:18px">Read →</span></div>
      </a>
    ) : (
      <ul class="articles" style="margin-top:44px">
        {upcoming.map((a) => <li><div class={`soon t-${tints[a.data.topic]}`}><span class="topic">{a.data.topic}</span><span class="t">{a.data.title}</span><span class="sum">{a.data.summary}</span><span class="rt">Coming soon</span></div></li>)}
      </ul>
    )}
  </div>
</section>
)}

<section class="sec pubs-sec" id="publications">
  <div class="wrap">
    <div class="intro"><div class="eyebrow">Publications</div><h2>Institutional reports</h2><p>Regional guidance and practice reports for WHO and Deloitte on health technology, data governance and medical oxygen.</p><a class="see-all" style="margin-top:22px" href="/publications/">All publications →</a></div>
    <ul class="pubs">
      {publications.slice(0, 3).map((p) => (
        <li><a href={p.href} target="_blank" rel="noopener"><span class="org" style={`--c:var(--${p.tint})`}>{p.org}</span><span><span class="t">{p.title}</span><span class="src">{p.src}</span></span><span class="arr">↗</span></a></li>
      ))}
    </ul>
  </div>
</section>
</Base>
