---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getArticles } from '../lib/writing';
import { lab } from '../data/site';
import PubList from '../components/PubList.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const homeWork = work.filter((w) => w.data.home).slice(0, 2);
const homeLab = lab.slice(0, 3);
const articles = await getArticles();
const published = articles.filter((a) => !a.data.draft);
const homeArticles = (published.filter((a) => a.data.featured).length ? published.filter((a) => a.data.featured) : published).slice(0, 2);
---
<Base>
<header class="hero" id="top">
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="wrap">
    <div>
      <div class="eyebrow">Hussain MS · Portfolio</div>
      <h1>Digital development and <span class="hl">public health.</span></h1>
      <div class="actions">
        <a class="btn primary" href="/work/">See work &amp; writing <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href="/about/">About me</a>
      </div>
    </div>
  </div>
</header>

<section class="sec pubs-sec" id="publications">
  <div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">Publications</div><h2>Institutional publications</h2></div><a class="see-all" href="/publications/">All publications →</a></div>
    <PubList compact />
  </div>
</section>

<section class="areas-intro" id="areas">
  <div class="wrap"><div class="eyebrow">Practice</div><h2>Areas of work</h2></div>
</section>

<div class="bands">
  <section class="band b1"><div class="wrap">
    <div class="idx">01 · DATA</div>
    <div class="body"><h3>Data-driven strategy</h3><p>Reading data from programme portals and field systems together, so national and state teams can see where to act and track what changes.</p></div>
  </div></section>
  <section class="band b2"><div class="wrap">
    <div class="idx">02 · DPI</div>
    <div class="body"><h3>Digital public infrastructure</h3><p>Shared building blocks such as digital IDs, registries and data standards, and the governance that lets public services build on them.</p></div>
  </div></section>
  <section class="band b3"><div class="wrap">
    <div class="idx">03 · PRODUCT</div>
    <div class="body"><h3>Digital product development</h3><p>Public-sector platforms taken from requirements and user journeys through testing to launch, with the people who will use them.</p></div>
  </div></section>
  <section class="band b4"><div class="wrap">
    <div class="idx">04 · GEOSPATIAL</div>
    <div class="body"><h3>GIS and geospatial tools</h3><p>Mapping need down to wards, slums and households, so teams can plan facilities and outreach where they matter most.</p></div>
  </div></section>
  <section class="band b5"><div class="wrap">
    <div class="idx">05 · AI</div>
    <div class="body"><h3>AI for development</h3><p>Practical AI tools for frontline workers and public services, and a careful look at which ones are ready for public use.</p></div>
  </div></section>
</div>
<div class="band-end" aria-hidden="true"></div>

<section class="sec work" id="work">
  <div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">Work &amp; Writing</div><h2>Selected case studies and articles</h2></div><a class="see-all" href="/work/">All work &amp; writing →</a></div>
    <div class="work-grid">
      {homeWork.map((w) => <CaseCard entry={w} />)}
      {homeArticles.map((a) => <ArticleCard entry={a} />)}
    </div>
  </div>
</section>

{homeLab.length > 0 && (
<section class="sec lab" id="lab">
  <div class="wrap">
    <div class="sec-head"><div><div class="eyebrow">Lab</div><h2>Tools and prototypes</h2></div><div class="side"><p>Working things I've built, from an AI-assisted national dashboard prototype to tools delivered to state governments.</p><a class="see-all" style="--c:var(--green)" href="/lab/">Explore the Lab →</a></div></div>
    <div class="lab-grid">
      {homeLab.map((t) => (
        <article class={`tool t-${t.tint}`} style={`--c:var(--${t.tint});--r:${t.shape}`}>
          <div class="ico"><span></span></div><span class="pill">{t.status}</span><h3>{t.title}</h3><p>{t.text}</p><a class="more" href={t.href}>View →</a>
        </article>
      ))}
    </div>
  </div>
</section>
)}

</Base>
