---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getArticles, isReadable } from '../../lib/writing';

export async function getStaticPaths() {
  const articles = (await getArticles()).filter(isReadable);
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.title} description={d.summary}>
<header class="page-head">
  <div class="wrap">
    <a class="crumb" href="/writing/">← All writing</a>
    <h1 style="max-width:22ch">{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <p class="note" style="margin-top:22px">{d.draft && 'DRAFT · '}{d.topic} · {date} · {d.minutes} min read</p>
  </div>
</header>
<section class="sec">
  <div class="wrap"><article class="prose" style="--c:var(--red)"><Content /></article></div>
</section>
</Base>
