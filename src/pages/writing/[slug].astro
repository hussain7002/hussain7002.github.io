---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getArticles, isReadable } from '../../lib/writing';

export async function getStaticPaths() {
  const articles = (await getArticles()).filter(isReadable);
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary}>
<header class="page-head">
  <div class="wrap">
    <a class="crumb" href="/work/#articles">← Work &amp; Writing</a>
    <h1 style="max-width:22ch">{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <p class="note" style="margin-top:22px">{d.draft && 'DRAFT · '}{d.topic}{d.firstWritten && ` · First written ${d.firstWritten}`} · {d.minutes} min read</p>
  </div>
</header>
{d.image ? (
  <div class="wrap">
    <figure class="lead-fig">
      <img src={d.image} alt={d.imageAlt ?? ''} width="1600" height="1000" decoding="async">
      <figcaption>{d.caption}{d.credit && <span class="credit"> {d.creditUrl ? <a href={d.creditUrl} target="_blank" rel="noopener">{d.credit}</a> : d.credit}</span>}</figcaption>
    </figure>
  </div>
) : (
  <div class="wrap">
    <figure class="lead-fig lead-placeholder" aria-hidden="true"><span>Image coming soon</span></figure>
  </div>
)}
<section class="sec">
  <div class="wrap"><article class="prose" style="--c:var(--red)">
    {d.keyPoints && d.keyPoints.length > 0 && (
      <div class="key-points"><p><strong>Key points</strong></p><ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul></div>
    )}
    <Content />
  </article></div>
</section>
</Base>
