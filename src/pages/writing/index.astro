---
import Base from '../../layouts/Base.astro';
import { getArticles, isReadable } from '../../lib/writing';
const articles = await getArticles();
const tints: Record<string, string> = { DPI: 'blue', 'Health data': 'green', 'Health systems': 'yellow', AI: 'red' };
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Writing" description="Essays on digital public infrastructure, health data, AI and how public health systems change.">
<header class="page-head">
  <div class="wrap">
    <div class="eyebrow" style="--dot:var(--red)">Writing</div>
    <h1>Essays and articles</h1>
    <p class="lede">On digital public infrastructure, health data, AI and how public systems actually change.</p>
  </div>
</header>
<section class="sec writing">
  <div class="wrap">
    {articles.length === 0
      ? <p class="lede">The first essays are being written. <a href="/work/">Read the case studies</a> in the meantime.</p>
      : <ul class="articles" style="margin-top:0">
          {articles.map((a) => (
            <li>{isReadable(a)
              ? <a href={`/writing/${a.id}/`} class={`t-${tints[a.data.topic]}`}><span class="topic">{a.data.draft && 'DRAFT · '}{a.data.topic}{!a.data.draft && ` · ${fmt(a.data.date)}`}</span><span class="t">{a.data.title}</span><span class="sum">{a.data.summary}</span><span class="rt">{a.data.minutes} min read</span></a>
              : <div class={`soon t-${tints[a.data.topic]}`}><span class="topic">{a.data.topic}</span><span class="t">{a.data.title}</span><span class="sum">{a.data.summary}</span><span class="rt">Coming soon</span></div>}</li>
          ))}
        </ul>}
  </div>
</section>
</Base>
